# 数据库连接。容器（云托管，与实例同一 VPC）走内网地址，不出公网、延迟更低。
#
# 本地调试注意：内网地址在 VPC 外不可达，本地要连库就用环境变量覆盖本文件
# （settings.py 用 os.environ.setdefault 注入，真实环境变量优先，不会被本文件覆盖）：
#
#   MYSQL_URL="mysql://root:<密码>@<公网地址>:<端口>/ledger" \
#     python3 manage.py runserver 127.0.0.1:80 --noreload
#
MYSQL_URL=mysql://root:c7gH7Ybw@10.35.103.46:3306/ledger
